# ─── Storage ────────────────────────────────────────────────────────────────
# Which backup store the API writes to. "sheets" (default) | "memory" (dev) | add your own.
STORAGE_DRIVER=sheets

# Google Sheets adapter (STORAGE_DRIVER=sheets)
# 1. Create a Google Cloud service account, enable the Google Sheets API.
# 2. Download its JSON key; paste the client_email and private_key below.
# 3. Create a Google Sheet and SHARE it (Editor) with the service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=your-sheet-id-from-its-url
GOOGLE_SERVICE_ACCOUNT_EMAIL=crm-bot@your-project.iam.gserviceaccount.com
# Keep the literal \n sequences; the adapter converts them to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# One Clerk application powers web + mobile sign-in (same user base).
CLERK_SECRET_KEY=sk_test_xxx              # server: verifies tokens in the API
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx   # web client
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx   # mobile client

# Dev-only: set to "1" to bypass auth locally (API trusts an x-dev-user header).
# NEVER enable in production.
DEV_AUTH_BYPASS=0

# ─── Mobile → API ─────────────────────────────────────────────────────────────
# The deployed website URL that hosts /api (the shared backend).
EXPO_PUBLIC_API_URL=http://localhost:3000
